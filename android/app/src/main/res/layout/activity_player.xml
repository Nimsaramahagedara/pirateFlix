<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Media3 ExoPlayer View -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="always"
        app:use_controller="true" />

    <!-- Top Info Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#B0000000"
        android:orientation="horizontal"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvPlayerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="DC (2026)" />

        <Button
            android:id="@+id/btnServer1"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_selector"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:text="Server 1"
            android:textColor="@color/text_white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnServer2"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_selector"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:text="Server 2"
            android:textColor="@color/text_white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnQuality"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_selector"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:text="Quality"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Buffering / Loading Indicator -->
    <ProgressBar
        android:id="@+id/playerLoading"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:indeterminateTint="@color/netflix_red"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Error Message -->
    <TextView
        android:id="@+id/tvPlayerError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/netflix_red"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playerLoading"
        tools:text="Failed to resolve stream link" />

</androidx.constraintlayout.widget.ConstraintLayout>
