<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/netflix_black">

    <!-- Cinematic Backdrop Image -->
    <ImageView
        android:id="@+id/ivSeriesBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        tools:src="@tools:sample/backgrounds/scenic" />

    <!-- Dark Ambient Vignette & Bottom/Left Gradients for readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0A0A0A" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_gradient" />

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="36dp"
        android:paddingEnd="48dp"
        android:paddingBottom="24dp">

        <!-- Top Row: App Brand / Back Indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NIMSARA TV"
                android:textColor="@color/netflix_red"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="•   TV SERIES"
                android:textColor="@color/text_gray"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Series Title -->
        <TextView
            android:id="@+id/tvSeriesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_white"
            android:textSize="32sp"
            android:textStyle="bold"
            tools:text="True Blood (2008)" />

        <!-- Metadata Badges Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSeriesYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_gray"
                android:textSize="13sp"
                tools:text="2008" />

            <TextView
                android:id="@+id/tvSeriesIMDb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="#E5B80B"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="IMDb 7.9" />

            <TextView
                android:id="@+id/tvSeriesRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="#B0000000"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/text_green"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="HD" />

            <TextView
                android:id="@+id/tvSeriesGenres"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/text_gray"
                android:textSize="12sp"
                tools:text="Drama • Fantasy • Mystery" />
        </LinearLayout>

        <!-- Synopsis -->
        <TextView
            android:id="@+id/tvSeriesSynopsis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="3"
            android:maxWidth="750dp"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            tools:text="Telepathic waitress Sookie Stackhouse discovers a strange new supernatural world when she meets Bill Compton, a southern Louisiana gentleman and vampire." />

        <!-- Seasons Selector Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="SEASONS"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:id="@+id/hsvSeasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutSeasons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Episodes List Section -->
        <TextView
            android:id="@+id/tvEpisodesHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="EPISODES"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEpisodes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:orientation="horizontal"
            tools:listitem="@layout/item_episode" />

    </LinearLayout>

    <!-- Loading Spinner -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/netflix_red"
        android:visibility="gone" />

    <!-- Error Display -->
    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#90000000"
        android:padding="16dp"
        android:textColor="@color/text_white"
        android:textSize="16sp"
        android:visibility="gone"
        tools:text="Unable to load series details" />

</FrameLayout>
