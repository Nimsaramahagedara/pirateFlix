<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/netflix_black">

    <!-- Dark gradient overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_gradient" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingTop="36dp"
            android:paddingEnd="48dp"
            android:paddingBottom="36dp">

            <!-- Top Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NIMSARA TV"
                    android:textColor="@color/netflix_red"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="•   SETTINGS &amp; SYSTEM"
                    android:textColor="@color/text_gray"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Cards Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <!-- Left Column: Software Update Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:background="@color/netflix_card_bg"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SOFTWARE UPDATE"
                        android:textColor="@color/netflix_red"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Check and install the latest NimsaraTV release directly from GitHub."
                        android:textColor="@color/text_gray"
                        android:textSize="13sp" />

                    <!-- Status Display Area -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="#161616"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvUpdateStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="3dp"
                            android:text="Press 'Check for Updates' to search for newer releases."
                            android:textColor="@color/text_white"
                            android:textSize="14sp" />

                        <!-- Release Notes / Details -->
                        <TextView
                            android:id="@+id/tvReleaseNotes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:maxLines="6"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp"
                            android:visibility="gone"
                            tools:text="What's new in v1.0.2: \n- Added auto-update mechanism\n- Fixed CineSubz maintenance detection" />

                        <!-- Progress Bar for Downloading -->
                        <ProgressBar
                            android:id="@+id/progressBarUpdate"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="16dp"
                            android:max="100"
                            android:progressDrawable="@android:drawable/progress_horizontal"
                            android:progressTint="@color/netflix_red"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvDownloadProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/text_green"
                            android:textSize="12sp"
                            android:visibility="gone"
                            tools:text="Downloading: 45% (12.4 MB / 27.5 MB)" />
                    </LinearLayout>

                    <!-- Update Action Buttons -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnCheckUpdate"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_button_selector"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:paddingHorizontal="24dp"
                            android:text="⟳  Check for Updates"
                            android:textColor="@color/text_white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnInstallUpdate"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="16dp"
                            android:background="@drawable/bg_button_selector"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:paddingHorizontal="24dp"
                            android:text="⬇  Download &amp; Install"
                            android:textColor="@color/text_white"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/btnGrantPermission"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="16dp"
                            android:background="@drawable/bg_button_selector"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:paddingHorizontal="20dp"
                            android:text="⚙  Enable Install Permission"
                            android:textColor="@color/text_white"
                            android:textSize="14sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Right Column: App & System Info Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_weight="1"
                    android:background="@color/netflix_card_bg"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SYSTEM INFORMATION"
                        android:textColor="@color/netflix_red"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCurrentVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textColor="@color/text_white"
                        android:textSize="14sp"
                        tools:text="App Version: v1.0.1 (Build 2)" />

                    <TextView
                        android:id="@+id/tvServerEndpoint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_gray"
                        android:textSize="13sp"
                        tools:text="Backend API: 34.31.38.62:8080" />

                    <TextView
                        android:id="@+id/tvUpdateSource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Update Source: github.com/Nimsaramahagedara/pirateFlix"
                        android:textColor="@color/text_gray"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnBack"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="32dp"
                        android:background="@drawable/bg_button_selector"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:paddingHorizontal="24dp"
                        android:text="←  Back to Home"
                        android:textColor="@color/text_white"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
